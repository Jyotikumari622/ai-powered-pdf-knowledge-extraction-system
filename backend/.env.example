FLASK_ENV=development

# Generate any random strings (python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-a-different-long-random-string

DATABASE_URL=sqlite:///documind.db
UPLOAD_FOLDER=uploads
MAX_UPLOAD_MB=20

# https://www.trychroma.com/ — Cloud API key, tenant ID, database name
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=

# https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
